# Copy this file to .env.local and fill it in. Never commit .env.local.

# Meta Model API key from https://dev.meta.ai/ (Billing requires a card on file).
META_API_KEY=

# NextAuth. NEXTAUTH_SECRET: any long random string (e.g. `openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Facebook Login — see docs/facebook-app-setup.md
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: Google sign-in. Leave empty to show Facebook only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public contact address shown on /data-deletion (required by Facebook to go Live).
CONTACT_EMAIL=
